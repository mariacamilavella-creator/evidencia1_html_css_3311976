---
// div : es una etiqueta abierta
// tiene elementos dentro
// permite especificar propiedades de ubicacion


 //Definimos las propiedades
 // que puede recibir el componente
 interface Props {
    etiqueta: string;
    
 }

// crear una variable
// para recibir el componente
// Astro.prost = Los valores desde el control
const etiqueta = Astro.props.etiqueta;
---
<label>{etiqueta}</label>
<div>
    <div id="cedula">
         <input 
          type="radio"
          name="rgb"
          id="radio1"
       />
     <strong> CC </strong>
</div>
<br/>
<div id="targeta">
      <input 
       type="radio"
       name="rgb"
       id="radio1"
     /> 
     <strong> TI </strong>
</div>
<br/>
<div id="extrangeria">
     <input 
       type="radio"
       name="rgb"
       id="radio1"
     /> 
     <strong> CE </strong>
     </div>
     <style>
      
      #cedula{
        background-color: rgb(215, 133, 240);
        display:inline;
        }
        
      #targeta{
        background-color: rgb(129, 248, 49);
        display:inline;
        }
        #extrangeria{
        background-color: rgb(148, 20, 26);
        display:inline;
        }
      
     </style>
</div>
